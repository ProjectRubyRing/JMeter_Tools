{
  "openapi": "3.0.3",
  "info": {
    "title": "OrdersApi",
    "description": "受注API（社内向け・プライベートREST API）",
    "version": "1.0.0",
    "contact": {
      "name": "API基盤チーム",
      "email": "api@example.com"
